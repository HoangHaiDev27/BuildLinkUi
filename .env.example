# URL backend mà Next.js rewrite /api/* sang (xem next.config.mjs)
# Local dev: có thể bỏ trống, mặc định dùng http://localhost:5074
# Trên Vercel: khai báo ở Settings -> Environment Variables, chọn scope:
#   - Production (nhánh main)      -> URL backend production
#   - Preview    (nhánh developer) -> URL backend dev/staging
BACKEND_API_URL=http://localhost:5074
